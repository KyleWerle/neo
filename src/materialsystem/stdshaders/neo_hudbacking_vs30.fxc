// The HUD's backings (Neo_HudBacking): screen-pixel geometry from the HUD's 2D pass, carrying where each pixel
// sits in the frame copy and the backing's look.
#include "common_vs_fxc.h"

struct VS_INPUT
{
	float4 vPos			: POSITION;
	float4 vColor		: COLOR0;		// r: target brightness, g: glitch, b: blur, a: opacity
	float2 vScreen		: TEXCOORD0;	// where the vertex sits in the frame copy (0 to 1)
	float3 vTime		: TEXCOORD1;	// x: seconds (wrapped), y: the backing's seed, z: motion (0 still to 1 full)
};

struct VS_OUTPUT
{
	float4 vProjPos		: POSITION;
	float2 vScreen		: TEXCOORD0;
	float3 vTime		: TEXCOORD1;
	float4 vLook		: TEXCOORD2;
};

VS_OUTPUT main( const VS_INPUT v )
{
	VS_OUTPUT o = ( VS_OUTPUT )0;
	o.vProjPos = mul( float4( v.vPos.xyz, 1.0f ), cModelViewProj );
	o.vScreen = v.vScreen;
	o.vTime = v.vTime;
	o.vLook = v.vColor;
	return o;
}
