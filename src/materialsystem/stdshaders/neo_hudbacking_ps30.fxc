// The HUD's backings (Neo_HudBacking): a blurred, darkened patch of the finished frame behind each HUD group, with
// a cyberbrain's noise in it. Bright pixels are pulled down toward a target and dark ones left as they are, so the
// linework reads on any scene with nothing to calibrate. Over it: a slow swell of long waves darkening through it with
// its contours rolling as thin lines, scanlines, now and then a row torn sideways, and an ordered dither into a few
// levels (all scaled by the glitch amount). With motion (the HUD's full motion; none when still): blocks of it now and
// then torn out of place, their colours rotated, and the rows tearing. All arithmetic: the nine taps of the blur are
// its only reads.
#include "common_ps_fxc.h"

sampler Scene				: register( s0 );	// a quarter-size copy of the frame
const float4 g_Texel		: register( c0 );	// xy: one texel of the copy, in its 0 to 1 coordinates

struct PS_INPUT
{
	float2 vScreen		: TEXCOORD0;
	float3 vTime		: TEXCOORD1;	// seconds, seed, motion (0 still to 1 full)
	float4 vLook		: TEXCOORD2;
	float2 vPixel		: VPOS;
};

float Hash( float2 p )
{
	return frac( sin( dot( p, float2( 12.9898f, 78.233f ) ) ) * 43758.5453f );
}

float4 main( const PS_INPUT i ) : COLOR
{
	const float target = i.vLook.r, glitch = i.vLook.g, alpha = i.vLook.a;
	const float radius = 0.75f + 2.5f * i.vLook.b;	// texels of the copy
	const float t = i.vTime.x, seed = i.vTime.y, motion = i.vTime.z;

	// Torn rows: bands 3 px tall, a few jumping sideways for a tick.
	float2 uv = i.vScreen;
	const float row = floor( i.vPixel.y / 3.0f ), tick = floor( t * 12.0f );
	const float tear = Hash( float2( row * 0.137f + seed, tick ) );
	float torn = 0.0f;
	if ( tear > 1.0f - 0.07f * glitch * motion )
	{
		torn = 1.0f;
		uv.x += ( Hash( float2( tick, row ) ) - 0.5f ) * 8.0f * g_Texel.x * ( 0.5f + glitch );
	}

	// Glitch blocks: here and there a block (28 x 9 px) torn out of place for a tick, each block on its own clock.
	const float2 block = floor( i.vPixel / float2( 28.0f, 9.0f ) );
	const float blockTick = floor( t * 7.0f + Hash( block * 0.37f + seed ) * 5.0f );
	float hit = 0.0f;
	if ( Hash( block * 0.173f + float2( blockTick, seed ) ) > 1.0f - 0.03f * glitch * motion )
	{
		hit = 1.0f;
		uv += ( float2( Hash( block + blockTick ), Hash( block - blockTick ) ) - 0.5f ) * g_Texel.xy * 24.0f;
	}

	// The blur: the centre and eight round it (the copy's bilinear filter does the rest).
	const float2 r = g_Texel.xy * radius;
	float3 c = tex2D( Scene, uv ).rgb * 0.2f;
	c += tex2D( Scene, uv + r * float2( 1.0f, 0.0f ) ).rgb * 0.1f;
	c += tex2D( Scene, uv + r * float2( -1.0f, 0.0f ) ).rgb * 0.1f;
	c += tex2D( Scene, uv + r * float2( 0.0f, 1.0f ) ).rgb * 0.1f;
	c += tex2D( Scene, uv + r * float2( 0.0f, -1.0f ) ).rgb * 0.1f;
	c += tex2D( Scene, uv + r * float2( 0.7f, 0.7f ) * 1.6f ).rgb * 0.1f;
	c += tex2D( Scene, uv + r * float2( -0.7f, 0.7f ) * 1.6f ).rgb * 0.1f;
	c += tex2D( Scene, uv + r * float2( 0.7f, -0.7f ) * 1.6f ).rgb * 0.1f;
	c += tex2D( Scene, uv + r * float2( -0.7f, -0.7f ) * 1.6f ).rgb * 0.1f;

	// Bright pulled down toward the target (a soft knee), dark left be.
	const float lum = dot( c, float3( 0.299f, 0.587f, 0.114f ) );
	const float pulled = lum > target ? target + ( lum - target ) * 0.2f : lum;
	c *= pulled / max( lum, 0.001f );

	// The swell: three long waves crossing at angles, a little bent, in screen heights so it holds at any resolution
	// (wavelengths 0.57, 0.39 and 0.27 of the screen's height, drifting about 3% of it a second). One sea under every
	// backing, darkening gently through its troughs; over it, its contours as thin lines, rolling with the waves.
	// (Still: t stands still, the client's.)
	const float2 q = float2( i.vScreen.x * g_Texel.y / g_Texel.x, i.vScreen.y );
	const float2 w = q + 0.05f * float2( sin( q.y * 5.0f + t * 0.21f ), sin( q.x * 4.0f - t * 0.17f ) );
	const float h = sin( dot( w, float2( 0.92f, 0.38f ) ) * 11.0f - t * 0.35f ) * 0.5f
		+ sin( dot( w, float2( -0.45f, 0.89f ) ) * 16.0f - t * 0.27f ) * 0.3f
		+ sin( dot( w, float2( 0.26f, -0.97f ) ) * 23.0f + t * 0.19f ) * 0.2f;
	const float cloud = h * 0.5f + 0.5f;
	c *= 1.0f - glitch * 0.18f * cloud;
	const float crest = h * 3.0f - t * 0.06f;
	const float fw = max( fwidth( crest ), 0.0001f );
	const float contour = 1.0f - smoothstep( fw * 0.8f, fw * 2.0f, abs( frac( crest ) - 0.5f ) );
	c += ( c + 0.03f ) * glitch * 0.45f * contour;

	// Scanlines, and the torn rows' colour split.
	c *= 1.0f - glitch * 0.08f * step( frac( i.vPixel.y / 3.0f ), 0.34f );
	c.rb += torn * glitch * float2( 0.04f, -0.02f );
	c = lerp( c, c.gbr * 1.4f + 0.02f, hit * 0.6f );

	// An ordered dither into a few levels, on 2 px cells, the pattern swimming a little with the cloud: the patch
	// reads as the cyberbrain's picture of the scene, not a glass pane.
	const float levels = lerp( 48.0f, 12.0f, glitch ) * ( 1.0f - 0.5f * hit );
	const float2 cell = floor( i.vPixel * 0.5f );
	const float2 half_ = floor( cell * 0.5f );
	const float bayer = frac( half_.x * 0.5f + half_.y * half_.y * 0.75f ) * 0.25f + frac( cell.x * 0.5f + cell.y * cell.y * 0.75f );
	const float threshold = frac( bayer + glitch * 0.25f * cloud );
	c = floor( saturate( c ) * levels + threshold ) / levels;

	return float4( c, alpha );
}
